{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manhwa Evaluation Ground Truth",
  "description": "Hand-labeled ground truth for evaluating the perception and understanding pipeline.",
  "type": "object",
  "required": ["source_pages", "panels", "characters"],
  "properties": {
    "source_pages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Filenames of the source manhwa pages used."
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["panel_id", "bbox", "reading_order"],
        "properties": {
          "panel_id": { "type": "string" },
          "bbox": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "w": { "type": "integer" },
              "h": { "type": "integer" }
            }
          },
          "reading_order": { "type": "integer" },
          "shot_type": { "type": "string", "enum": ["close_up", "medium", "wide", "splash"] },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "speaker", "language"],
              "properties": {
                "text": { "type": "string" },
                "speaker": { "type": "string" },
                "language": { "type": "string" },
                "emotion": { "type": "string" },
                "bbox": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "integer" },
                    "y": { "type": "integer" },
                    "w": { "type": "integer" },
                    "h": { "type": "integer" }
                  }
                }
              }
            }
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "emotion": { "type": "string" },
                "pose": { "type": "string" }
              }
            }
          },
          "action_description": { "type": "string" }
        }
      }
    },
    "characters": {
      "type": "object",
      "description": "Character ID to full character profile mapping.",
      "additionalProperties": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "appearances": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
